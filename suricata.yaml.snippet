# -----------------------------------------------------------------
# Relevant sections modified in /etc/suricata/suricata.yaml
# (Full default file is generated by Suricata on install; only the
#  lines below were changed for this project.)
# -----------------------------------------------------------------

vars:
  address-groups:
    HOME_NET: "[10.0.0.0/24]"      # Changed from the default multi-range value
                                     # to match this lab's NAT Network subnet

af-packet:
  - interface: eth0                 # Interface confirmed via `ip a`

outputs:
  - eve-log:
      enabled: yes
      filetype: json
      filename: eve.json

  - fast:
      enabled: yes
      filename: fast.log
      append: yes

rule-files:
  - suricata.rules
  - /etc/suricata/rules/local.rules   # Custom rule file added here
